<Window x:Class="Elcano.App.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexión de almacenamiento" Width="520" Height="680" ResizeMode="NoResize" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource AppBackground}" UseLayoutRounding="True">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Nueva conexión" x:Name="DialogHeading" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Configura el acceso a tus archivos." Foreground="{DynamicResource Muted}" Margin="0,8,0,8"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,18,0,0" x:Name="Fields">
      <TextBlock Text="Nombre" Margin="0,0,0,5"/>
      <TextBox x:Name="NameInput" Tag="Ej. Producción" Style="{StaticResource PlaceholderTextBox}" MaxLength="100"/>
      <TextBlock Text="Dirección del servidor" Margin="0,12,0,5"/>
      <TextBox x:Name="EndpointInput" Tag="https://storage.ejemplo.com" Style="{StaticResource PlaceholderTextBox}"/>
      <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Región" Margin="0,0,0,5"/><TextBox x:Name="RegionInput" Tag="Ej. us-east-1" Style="{StaticResource PlaceholderTextBox}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Bucket fijo (opcional)" Margin="0,0,0,5"/><TextBox x:Name="BucketInput" Tag="Nombre del bucket" Style="{StaticResource PlaceholderTextBox}"/></StackPanel>
      </Grid>
      <TextBlock Text="Access key" Margin="0,12,0,5"/>
      <TextBox x:Name="AccessInput" Tag="Tu clave de acceso" Style="{StaticResource PlaceholderTextBox}"/>
      <TextBlock Text="Secret key" Margin="0,12,0,5"/>
      <Grid>
        <PasswordBox x:Name="SecretInput" PasswordChanged="SecretChanged"/>
        <TextBlock x:Name="SecretPlaceholder" Text="Tu clave secreta" Foreground="{DynamicResource PlaceholderBrush}" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock Text="Las credenciales se cifran con tu usuario de Windows. Si el acceso se limita a un bucket, indica su nombre en Bucket fijo." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2">
      <TextBlock x:Name="Feedback" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,14"/>
      <DockPanel>
        <Button x:Name="TestButton" Content="Probar conexión" Click="TestConnection" DockPanel.Dock="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancelar" IsCancel="True"/>
          <Button x:Name="SaveButton" Content="Guardar" Click="SaveConnection" Style="{StaticResource PrimaryButton}" Margin="0" IsDefault="True"/>
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Grid>
</Window>
