<Window x:Class="MinioDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinioDesk" Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Background="#F3F6F8">
    <Grid.RowDefinitions>
      <RowDefinition Height="88"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="270" MaxWidth="500"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The explorer spans the full window height. -->
    <Border Grid.RowSpan="3" Background="#FFFFFF" BorderBrush="#DEE5EA" BorderThickness="0,0,1,0">
      <Grid Margin="18,24,18,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,0,24">
          <TextBlock Text="◈  MinioDesk" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="EXPLORADOR DE ARCHIVOS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
          <TextBlock Text="BUCKET" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <Grid>
            <ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket}" IsEnabled="{Binding IsIdle}" Height="36" Padding="8,4"/>
            <TextBlock Text="Selecciona un bucket" Margin="12,0,28,0" Foreground="#8193A0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedBucket}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,12">
          <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" Margin="0,0,8,0" ToolTip="Carpeta superior" AutomationProperties.Name="Carpeta superior">
            <Path Data="M 1,6 L 6,1 L 11,6 M 6,1 L 6,13" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="12" Height="13" Stretch="Uniform"/>
          </Button>
          <TextBlock Text="{Binding Location}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding Location}"/>
        </DockPanel>
        <TextBox Grid.Row="3" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrar esta página…" Style="{StaticResource PlaceholderTextBox}" Margin="0,0,0,12"/>
        <Grid Grid.Row="4" Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Content="Actualizar" Command="{Binding RefreshCommand}" Padding="8,7" Margin="0,0,6,0"/>
          <Button Grid.Column="1" Content="Subir archivos" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Padding="8,7" Margin="6,0,0,0"/>
        </Grid>
        <Grid Grid.Row="5">
          <ListBox x:Name="ObjectGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                   MouseDoubleClick="OpenObject" KeyDown="OpenObjectKey"
                   IsEnabled="{Binding IsIdle}" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="10,11"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F6F8"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E1EFEF"/></Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Key}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      <TextBlock Text="{Binding SizeLabel}" Margin="0,5,0,0"/>
                      <TextBlock Text="{Binding ModifiedLabel, StringFormat='Modificado: {0}'}"/>
                    </StackPanel>
                  </Grid.ToolTip>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Path Stroke="{StaticResource Accent}" StrokeThickness="1.3" Width="17" Height="19" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 1,0 L 10,0 L 16,6 L 16,20 L 1,20 Z M 10,0 L 10,6 L 16,6"/><Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Data" Value="M 0,3 L 7,3 L 9,6 L 20,6 L 20,18 L 0,18 Z"/></DataTrigger></Style.Triggers></Style></Path.Style>
                  </Path>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                      <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{StaticResource Muted}"/>
                      <TextBlock Text="{Binding SizeLabel, StringFormat=' · {0}'}" FontSize="10" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Aquí aparecerán tus archivos." Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Entries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
        </Grid>
        <StackPanel Grid.Row="6" Margin="0,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="Ver Parquet" Command="{Binding PreviewCommand}" Padding="8,7" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Descargar" Command="{Binding DownloadCommand}" Padding="8,7" Margin="6,0,0,0"/>
          </Grid>
          <Border Height="1" Background="#E5EBEF" Margin="0,16,0,12"/>
          <TextBlock Text="{Binding PageLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Content="Anterior" Command="{Binding PreviousPageCommand}" Padding="8,5" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Siguiente" Command="{Binding NextPageCommand}" Padding="8,5" Margin="6,0,0,0"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- Connection controls remain in the upper-right corner. -->
    <Grid Grid.Column="2" Margin="24,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Visor de archivos" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <DockPanel Margin="0,0,0,5">
          <TextBlock Text="CONEXIÓN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="{Binding ConnectionState}" Foreground="{StaticResource Accent}" FontSize="10" HorizontalAlignment="Right"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal">
          <Grid Width="188" Margin="0,0,8,0">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                      IsEnabled="{Binding IsIdle}" Height="34" Padding="8,4" ToolTip="{Binding SelectedProfile.Endpoint}" AutomationProperties.Name="Seleccionar conexión"/>
            <TextBlock Text="Seleccionar conexión" Foreground="#8193A0" Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Style="{StaticResource IconButton}" Height="34" Width="34" Command="{Binding AddConnectionCommand}" Margin="0,0,8,0" ToolTip="Nueva conexión" AutomationProperties.Name="Nueva conexión">
            <Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
          <Button Content="⋯" Width="34" Height="34" Padding="0" Margin="0,0,8,0" Click="OpenConnectionMenu" ToolTip="Administrar conexión" AutomationProperties.Name="Administrar conexión" IsEnabled="{Binding IsIdle}">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Editar conexión" Command="{Binding EditConnectionCommand}"/>
                <MenuItem Header="Quitar conexión" Command="{Binding RemoveConnectionCommand}"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="Conectar" Height="34" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Column="2" Grid.Row="1" Margin="24,0,24,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FCEDEA" BorderBrush="#EAC2B9" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Error}" Foreground="#8C3327" TextWrapping="Wrap"/>
      </Border>
      <Border Grid.Row="1" Background="White" BorderBrush="#DEE5EA" BorderThickness="1" CornerRadius="8">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="28">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPreviewOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Border Width="76" Height="76" CornerRadius="20" Background="#E9F3F3" Margin="0,0,0,24">
              <Path Data="M 0,0 L 36,0 L 36,32 L 0,32 Z M 0,10 L 36,10 M 12,0 L 12,32 M 24,0 L 24,32" Width="35" Height="32" Stretch="Uniform" Stroke="{StaticResource Accent}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Abre un archivo" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="Haz doble clic en un Parquet del explorador para visualizar sus datos y su esquema." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,12,0,22" FontSize="14"/>
            <Button Content="Abrir Parquet local" Command="{Binding LocalPreviewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0"/>
          </StackPanel>
          <Grid Margin="20" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="{Binding PreviewTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding PreviewSummary}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="12"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Abrir local" Command="{Binding LocalPreviewCommand}" Padding="10,6"/>
                <Button Content="Cerrar" Command="{Binding ClosePreviewCommand}" Padding="10,6" Margin="0"/>
              </StackPanel>
            </Grid>
            <TabControl Grid.Row="1" BorderThickness="0" Background="White">
              <TabItem Header="Datos"><DataGrid ItemsSource="{Binding PreviewRows}" AutoGeneratingColumn="PreviewColumn"/></TabItem>
              <TabItem Header="Esquema"><DataGrid ItemsSource="{Binding PreviewSchema}"/></TabItem>
            </TabControl>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Column="2" Grid.Row="2" Background="White" BorderBrush="#DEE5EA" BorderThickness="0,1,0,0" Padding="20,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ProgressBar Grid.Column="1" Height="5" Value="{Binding Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" Margin="12,0,0,0" Padding="9,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
      </Grid>
    </Border>
  </Grid>
</Window>


