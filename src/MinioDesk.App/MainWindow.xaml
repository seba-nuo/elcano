<Window x:Class="MinioDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MinioDesk.App"
        Title="MinioDesk" Width="1360" Height="860" MinWidth="1080" MinHeight="680" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Grid Background="{DynamicResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="240" MaxWidth="500"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- The explorer spans the full window height. -->
    <Border Grid.RowSpan="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="14,20,14,14">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,0,20">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="◈  MinioDesk" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Command="{Binding ToggleThemeCommand}" Style="{StaticResource IconButton}" ToolTip="{Binding ThemeAction}" AutomationProperties.Name="{Binding ThemeAction}">
              <Grid Width="18" Height="18">
                <Path Fill="{DynamicResource Ink}" Data="M 12,0 A 9,9 0 1 0 18,12 A 8,8 0 0 1 12,0 Z" Stretch="Uniform">
                  <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding IsDarkTheme}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>
                <Path Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Data="M 10,5 A 5,5 0 1 1 9.99,5 M 10,0 L 10,2 M 10,18 L 10,20 M 0,10 L 2,10 M 18,10 L 20,10 M 3,3 L 4.5,4.5 M 15.5,15.5 L 17,17 M 3,17 L 4.5,15.5 M 15.5,4.5 L 17,3" Stretch="Uniform">
                  <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDarkTheme}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                </Path>
              </Grid>
            </Button>
          </Grid>
          <TextBlock Text="EXPLORADOR DE ARCHIVOS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="BUCKET" FontSize="10" Foreground="{DynamicResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding ExplorerCacheLabel}" ToolTip="{Binding ExplorerCacheDetails}" Foreground="{DynamicResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="4,0,8,0"/>
            <CheckBox Grid.Column="2" Content="Precarga" IsChecked="{Binding PrefetchEnabled}" FontSize="10" ToolTip="Precargar listados lentamente en segundo plano. Desactívalo para reducir peticiones de red."/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,8,0">
              <ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket}" IsEnabled="{Binding IsIdle}" Height="34" Padding="8,4"/>
              <TextBlock Text="Selecciona un bucket" Margin="12,0,28,0" Foreground="{DynamicResource PlaceholderBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedBucket}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" Width="34" Height="34" ToolTip="Actualizar archivos" AutomationProperties.Name="Actualizar archivos">
              <Path Data="M 16,5 A 7,7 0 1 0 17,13 M 16,1 L 16,6 L 11,6" Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Ink}" StrokeThickness="1.5"/>
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
        <DockPanel>
          <Button DockPanel.Dock="Right" Command="{Binding UploadCommand}" Style="{StaticResource IconButton}" Margin="8,0,0,0" ToolTip="Subir archivos a esta carpeta" AutomationProperties.Name="Subir archivos">
            <Path Data="M 3,7 L 9,1 L 15,7 M 9,1 L 9,14 M 1,12 L 1,18 L 17,18 L 17,12" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="16" Height="17" Stretch="Uniform"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" Margin="0,0,8,0" ToolTip="Carpeta superior" AutomationProperties.Name="Carpeta superior">
            <Path Data="M 1,6 L 6,1 L 11,6 M 6,1 L 6,13" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="12" Height="13" Stretch="Uniform"/>
          </Button>
          <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Click="OpenBreadcrumb" Tag="{Binding}" Style="{StaticResource BreadcrumbButton}"
                        IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding Hint}">
                  <TextBlock Text="{Binding Name}" MaxWidth="84" TextTrimming="CharacterEllipsis" FontSize="11"/>
                </Button>
                <TextBlock Text="›" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="1,0">
                  <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
        <TextBox x:Name="FolderPathText" Text="{Binding FolderPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"
                 Background="Transparent" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,6,0,0"
                 ToolTip="{Binding FolderPath}" TextChanged="FolderPathChanged" HorizontalScrollBarVisibility="Hidden"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Tag="Filtrar esta página…" Style="{StaticResource PlaceholderTextBox}"/>
          <Button Grid.Column="1" Content="×" Command="{Binding ClearFilterCommand}" Style="{StaticResource IconButton}" Margin="4,0,0,0" Visibility="{Binding HasFilter, Converter={StaticResource BoolVisibility}}" ToolTip="Limpiar filtro" AutomationProperties.Name="Limpiar filtro"/>
        </Grid>

        <Grid Grid.Row="5">
          <ListBox x:Name="ObjectGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                   MouseDoubleClick="OpenObject" KeyDown="OpenObjectKey" PreviewMouseRightButtonDown="SelectContextFile" ContextMenuOpening="OpenFileMenu"
                   ScrollViewer.ScrollChanged="ExplorerScrolled"
                   IsEnabled="{Binding IsIdle}" BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="{Binding DownloadAction}" Command="{Binding DownloadCommand}"/>
                <MenuItem Header="{Binding DeleteAction}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource ErrorText}"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Margin" Value="0,0,0,1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                  <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value>
                </Setter>
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                </Style.Triggers>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ToolTip>
                    <StackPanel MaxWidth="360">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Key}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                      <TextBlock Text="{Binding SizeLabel}" Margin="0,5,0,0"/>
                      <TextBlock Text="{Binding ModifiedLabel, StringFormat='Modificado: {0}'}"/>
                    </StackPanel>
                  </Grid.ToolTip>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Path Stroke="{DynamicResource Accent}" StrokeThickness="1.3" Width="14" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 1,0 L 10,0 L 16,6 L 16,20 L 1,20 Z M 10,0 L 10,6 L 16,6"/><Style.Triggers><DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Data" Value="M 0,3 L 7,3 L 9,6 L 20,6 L 20,18 L 0,18 Z"/></DataTrigger></Style.Triggers></Style></Path.Style>
                  </Path>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                      <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                      <TextBlock Text="{Binding SizeLabel, StringFormat=' · {0}'}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding ExplorerEmptyMessage}" Foreground="{DynamicResource Muted}" FontSize="12" TextAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Entries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <Border Background="{DynamicResource Surface}" Visibility="{Binding IsExplorerLoading, Converter={StaticResource BoolVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
              <Grid Width="28" Height="28" Margin="0,0,0,12" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><RotateTransform x:Name="ExplorerLoadingRotation"/></Grid.RenderTransform>
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><Trigger Property="IsVisible" Value="True">
                  <Trigger.EnterActions><BeginStoryboard Name="ExplorerLoadingSpin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                  <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="ExplorerLoadingSpin"/></Trigger.ExitActions>
                </Trigger></Style.Triggers></Style></Grid.Style>
                <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="2.5" Margin="3"/>
                <Path Data="M 14,3 A 11,11 0 0 1 25,14" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
              <TextBlock Text="Cargando archivos…" Foreground="{DynamicResource Muted}" TextAlignment="Center" FontSize="12"/>
            </StackPanel>
          </Border>
        </Grid>
        <Border x:Name="PaginationFooter" Grid.Row="6" Margin="0,8,0,0" Padding="0,7,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding PageLabel}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PageLabel}"/>
              <TextBlock Text="{Binding FolderCountLabel}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderCountLabel}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,4,0" ToolTip="Página anterior" AutomationProperties.Name="Página anterior">
                <Path Data="M 7,1 L 2,6 L 7,11" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="6" Height="11" Stretch="Uniform"/>
              </Button>
              <Button Command="{Binding NextPageCommand}" Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="Página siguiente" AutomationProperties.Name="Página siguiente">
                <Path Data="M 2,1 L 7,6 L 2,11" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="6" Height="11" Stretch="Uniform"/>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Surface}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- Connection controls remain in the upper-right corner. -->
    <Grid Grid.Column="2" Margin="12,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Visor de archivos" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Grid Width="188" Margin="0,0,8,0">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                      IsEnabled="{Binding IsIdle}" Height="34" Padding="8,4" ToolTip="{Binding SelectedProfile.Endpoint}" AutomationProperties.Name="Seleccionar conexión"/>
            <TextBlock Text="Seleccionar conexión" Foreground="{DynamicResource PlaceholderBrush}" Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProfile}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Style="{StaticResource IconButton}" Height="34" Width="34" Command="{Binding AddConnectionCommand}" Margin="0,0,8,0" ToolTip="Nueva conexión" AutomationProperties.Name="Nueva conexión">
            <Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
          </Button>
          <Button Content="⋯" Width="34" Height="34" Padding="0" Margin="0,0,8,0" Click="OpenConnectionMenu" ToolTip="Administrar conexión" AutomationProperties.Name="Administrar conexión" IsEnabled="{Binding IsIdle}">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem Header="Editar conexión" Command="{Binding EditConnectionCommand}"/>
                <MenuItem Header="Quitar conexión" Command="{Binding RemoveConnectionCommand}"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button Content="Conectar" Height="34" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Margin="0"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Column="2" Grid.Row="1">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
        <DockPanel><Button DockPanel.Dock="Right" Content="Copiar diagnóstico" Command="{Binding CopyDiagnosticCommand}" Padding="8,4" Margin="12,0,0,0" ToolTip="Copia una referencia y datos técnicos sin credenciales ni consultas SQL."/>
          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="28">
            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsPreviewOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <Border Width="76" Height="76" CornerRadius="20" Background="{DynamicResource SelectionBrush}" Margin="0,0,0,24">
              <Path Data="M 0,0 L 36,0 L 36,32 L 0,32 Z M 0,10 L 36,10 M 12,0 L 12,32 M 24,0 L 24,32" Width="35" Height="32" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Abre un archivo" FontSize="26" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock Text="Haz doble clic en un archivo Parquet, CSV o TXT del explorador para visualizarlo." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,12,0,22" FontSize="14"/>
            <Button Content="Abrir archivo local" Command="{Binding LocalPreviewCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0"/>
          </StackPanel>
          <Grid x:Name="FileViewer" Margin="12" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="{Binding PreviewTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBox x:Name="PreviewPathText" Text="{Binding PreviewPath, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"
                         Background="Transparent" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0"
                         ToolTip="{Binding PreviewPath}" HorizontalScrollBarVisibility="Hidden"/>
                <TextBlock Text="{Binding PreviewSummary}" ToolTip="{Binding PreviewSummary}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PreviewLimitsLabel}" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" FontSize="10" TextWrapping="Wrap" Visibility="{Binding IsTabularPreview, Converter={StaticResource BoolVisibility}}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Columnas" Command="{Binding ChooseColumnsCommand}" Padding="10,6" ToolTip="Elige hasta 64 columnas del resultado. Ejecuta primero cualquier cambio de la consulta." Visibility="{Binding IsTabularPreview, Converter={StaticResource BoolVisibility}}"/>
                <Button Content="Abrir local" Command="{Binding LocalPreviewCommand}" Padding="10,6"/>
                <Button Content="Cerrar" Command="{Binding ClosePreviewCommand}" Padding="10,6" Margin="0"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,8" Visibility="{Binding IsTabularPreview, Converter={StaticResource BoolVisibility}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="SQL · tabla archivo" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <CheckBox Content="Vista previa automática" IsChecked="{Binding AutoRunQuery}" Margin="0,0,14,0" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}"/>
                  <Button Content="Restablecer" Command="{Binding ResetQueryCommand}" Padding="10,5"/>
                  <Button Content="Ejecutar · Ctrl+Enter" Command="{Binding ExecuteQueryCommand}" Style="{StaticResource PrimaryButton}" Padding="10,5" Margin="0"/>
                </StackPanel>
              </Grid>
              <local:SqlEditor x:Name="QueryEditor" Grid.Row="1" Height="44" MinHeight="44" Padding="8,6" BoundText="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                       FontFamily="Consolas" FontSize="13" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
                       BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding IsPreviewOpen}"
                       TextChanged="QueryChanged" SelectionChanged="QuerySelectionChanged" PreviewKeyDown="QueryKeyDown"
                       ToolTip="Consulta el archivo como tabla archivo. Ctrl+Espacio: columnas. Ctrl+Enter: ejecutar."/>
              <Thumb x:Name="QueryResizeHandle" Grid.Row="2" Height="9" Cursor="SizeNS" DragDelta="ResizeQueryEditor" ToolTip="Arrastra para cambiar la altura del editor SQL" AutomationProperties.Name="Cambiar altura del editor SQL">
                <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Height="2" Width="34" Background="{DynamicResource InputBorder}" CornerRadius="1" VerticalAlignment="Center"/></Grid></ControlTemplate></Thumb.Template>
              </Thumb>
              <Popup x:Name="CompletionPopup" PlacementTarget="{Binding ElementName=QueryEditor}" Placement="Relative" StaysOpen="False" AllowsTransparency="True">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="5" Padding="4" MinWidth="260" MaxWidth="400">
                  <StackPanel>
                    <TextBlock Text="Columnas y SQL · Tab para insertar" Foreground="{DynamicResource Muted}" FontSize="10" Margin="6,3,6,5"/>
                    <ListBox x:Name="CompletionList" MaxHeight="190" BorderThickness="0" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" MouseDoubleClick="AcceptCompletion">
                      <ListBox.ItemTemplate><DataTemplate><Grid Margin="6,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" Margin="0,0,20,0"/><TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </Border>
              </Popup>
              <Border Grid.Row="3" Background="{DynamicResource ErrorBackground}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,8,0,0" Visibility="{Binding HasQueryError, Converter={StaticResource BoolVisibility}}">
                <TextBox Text="{Binding QueryError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ErrorText}" Padding="0"/>
              </Border>
            </Grid>
            <TabControl Grid.Row="2" BorderThickness="0" Background="{DynamicResource Surface}" Visibility="{Binding IsTabularPreview, Converter={StaticResource BoolVisibility}}">
              <TabItem Header="Datos"><DataGrid x:Name="PreviewGrid" ItemsSource="{Binding PreviewItems}" AutoGeneratingColumn="PreviewColumn" Sorting="SortPreview" ToolTip="Ordena solo las filas de esta vista. Para ordenar todo el archivo usa ORDER BY. Selecciona texto o celdas y pulsa Ctrl+C para copiar."/></TabItem>
              <TabItem Header="Esquema"><DataGrid ItemsSource="{Binding PreviewSchema}" AutoGeneratingColumn="SchemaColumn"/></TabItem>
            </TabControl>
            <TextBox Grid.Row="2" Text="{Binding PreviewText, Mode=OneWay}" Visibility="{Binding IsTextPreview, Converter={StaticResource BoolVisibility}}"
                     IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
          </Grid>
          <Border Background="{DynamicResource Surface}" Visibility="{Binding IsFileLoading, Converter={StaticResource BoolVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
              <Grid Width="36" Height="36" Margin="0,0,0,16" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><RotateTransform x:Name="LoadingRotation"/></Grid.RenderTransform>
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><Trigger Property="IsVisible" Value="True">
                  <Trigger.EnterActions><BeginStoryboard Name="LoadingSpin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                  <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="LoadingSpin"/></Trigger.ExitActions>
                </Trigger></Style.Triggers></Style></Grid.Style>
                <Ellipse Stroke="{DynamicResource BorderBrush}" StrokeThickness="3" Margin="3"/>
                <Path Data="M 18,3 A 15,15 0 0 1 33,18" Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
              <TextBlock Text="Abriendo archivo…" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
              <TextBlock Text="{Binding LoadingFileName}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="StatusFooter" Grid.Column="2" Grid.Row="2" Height="44" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <ProgressBar Grid.Column="1" Height="5" Value="{Binding Progress, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" Margin="12,0,0,0" Padding="9,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        <TextBlock x:Name="ConnectionStatusText" Grid.Column="3" Text="{Binding ConnectionState}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ErrorText}"/><Style.Triggers>
            <DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
          </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</Window>


