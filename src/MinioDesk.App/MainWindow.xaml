<Window x:Class="MinioDesk.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MinioDesk" Width="1280" Height="820" MinWidth="1020" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Background="#F3F6F8">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="254"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#132D3B" Grid.RowSpan="2">
      <Grid Margin="20,28,20,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="◈  MinioDesk" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="OBJECT STORAGE EXPLORER" Foreground="#95AEBB" FontSize="10" Margin="0,8,0,32"/></StackPanel>
        <Grid Grid.Row="1" Height="32" Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="CONEXIONES" Foreground="#95AEBB" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding AddConnectionCommand}" ToolTip="Añadir conexión" AutomationProperties.Name="Añadir conexión">
            <Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </Grid>
        <ListBox Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding IsIdle}" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="11,12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Endpoint}" FontSize="11" Foreground="#95AEBB" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="3"><WrapPanel Margin="0,12,0,16"><Button Content="Editar" Command="{Binding EditConnectionCommand}" Padding="10,6"/><Button Content="Quitar" Command="{Binding RemoveConnectionCommand}" Padding="10,6"/></WrapPanel><Border Height="1" Background="#31505E"/><TextBlock Text="WINDOWS · WPF" Foreground="#95AEBB" FontSize="10" Margin="0,18,0,0"/><TextBlock Text="Conexiones cifradas en este equipo" Foreground="#95AEBB" FontSize="10" Margin="0,6,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="28,26,28,18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tus archivos" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding EndpointLabel}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E1EFEF" CornerRadius="12" Height="34" Padding="12,0" Margin="0,0,12,0" VerticalAlignment="Center"><TextBlock Text="{Binding ConnectionState}" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Button Content="Conectar" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButton}" Height="34" VerticalAlignment="Center" Margin="0"/></StackPanel></Grid>
      <Border Grid.Row="1" Background="#FCEDEA" BorderBrush="#EAC2B9" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" Foreground="#8C3327" TextWrapping="Wrap"/></Border>
      <Grid Grid.Row="2" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BUCKET" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket}" Height="34" IsEnabled="{Binding IsIdle}" Padding="8,4"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Button Content="Abrir Parquet local" Command="{Binding LocalPreviewCommand}" Margin="0"/></StackPanel></Grid>
      <Border Grid.Row="3" Background="White" BorderBrush="#DEE5EA" BorderThickness="1" CornerRadius="8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="16,15"><Button Style="{StaticResource IconButton}" Command="{Binding UpCommand}" Margin="0,0,8,0" ToolTip="Carpeta superior" AutomationProperties.Name="Carpeta superior"><Path Data="M 1,6 L 6,1 L 11,6 M 6,1 L 6,13" Stroke="{StaticResource Ink}" StrokeThickness="1.5" Width="12" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><TextBlock Text="{Binding Location}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
          <Grid Grid.Row="1" Margin="16,0,16,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="230" HorizontalAlignment="Left"><TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filtrar nombres de la página actual" MaxWidth="230" HorizontalAlignment="Left" Width="230" Padding="9,6"/><TextBlock Text="Filtrar esta página…" Foreground="#8193A0" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Filter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Actualizar" Command="{Binding RefreshCommand}" Padding="10,6"/><Button Content="Subir" Command="{Binding UploadCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6"/><Button Content="Descargar" Command="{Binding DownloadCommand}" Padding="10,6"/><Button Content="Ver Parquet" Command="{Binding PreviewCommand}" Padding="10,6" Margin="0"/></StackPanel></Grid>
          <Grid Grid.Row="2"><DataGrid x:Name="ObjectGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" AutoGenerateColumns="False" MouseDoubleClick="OpenObject" IsEnabled="{Binding IsIdle}" CanUserSortColumns="True"><DataGrid.Columns><DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Tamaño" Binding="{Binding SizeLabel}" Width="100"/><DataGridTextColumn Header="Modificado" Binding="{Binding ModifiedLabel}" Width="165"/></DataGrid.Columns></DataGrid><TextBlock Text="Conecta un servidor para explorar sus buckets.&#x0a;También puedes abrir un Parquet de tu equipo." Foreground="{StaticResource Muted}" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Entries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <DockPanel Grid.Row="3" Margin="16,12"><TextBlock Text="{Binding PageLabel}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Anterior" Command="{Binding PreviousPageCommand}" Padding="10,4"/><Button Content="Siguiente" Command="{Binding NextPageCommand}" Padding="10,4" Margin="0"/></StackPanel></DockPanel>
        </Grid>
      </Border>
      <Border Grid.Row="4" Height="260" Margin="0,16,0,0" Padding="14,12" Background="White" BorderBrush="#DEE5EA" BorderThickness="1" CornerRadius="8" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolVisibility}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><Button Content="Cerrar" DockPanel.Dock="Right" Command="{Binding ClosePreviewCommand}" HorizontalAlignment="Right" Padding="9,3" Margin="0"/><TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/></DockPanel><TabControl Grid.Row="1" BorderThickness="0"><TabItem Header="Vista previa · hasta 200 filas"><DataGrid ItemsSource="{Binding PreviewRows}" AutoGeneratingColumn="PreviewColumn"/></TabItem><TabItem Header="Esquema"><DataGrid ItemsSource="{Binding PreviewSchema}"/></TabItem></TabControl></Grid></Border>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" Background="White" BorderBrush="#DEE5EA" BorderThickness="0,1,0,0" Padding="20,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><ProgressBar Grid.Column="1" Height="5" Value="{Binding Progress, Mode=OneWay}" Minimum="0" Maximum="100" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/><Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" Margin="12,0,0,0" Padding="9,4" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/></Grid></Border>
  </Grid>
</Window>


