<Window x:Class="MinioDesk.App.ColumnsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Columnas de la vista previa" Width="480" Height="560" MinWidth="400" MinHeight="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource Ink}" Background="{DynamicResource Surface}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Columnas del resultado" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Elige entre 1 y 64 columnas. Se conserva el orden del resultado SQL." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
    <TextBox x:Name="Search" Grid.Row="1" Tag="Buscar columna…" Style="{StaticResource PlaceholderTextBox}" TextChanged="FilterColumns" Margin="0,0,0,10"/>
    <DockPanel Grid.Row="2" Margin="0,0,0,10"><Button Content="Primeras 64" Click="SelectFirst" Padding="8,4"/><Button Content="Ninguna" Click="SelectNone" Padding="8,4"/><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></DockPanel>
    <ListBox x:Name="ColumnsList" Grid.Row="3" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Type}" Margin="4,5"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Cancelar" IsCancel="True"/><Button x:Name="ApplyButton" Content="Aplicar" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Apply" Margin="0"/></StackPanel>
  </Grid>
</Window>
